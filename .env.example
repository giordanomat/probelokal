# Vorlage für die lokale Datei .env (wird nicht eingecheckt).
# In Cloudflare Pages dieselben Namen unter Settings → Variables and Secrets setzen.
#
# Nur öffentliche Werte! Beide stehen sowieso im Browser; geschützt wird über RLS in der Datenbank.
# NIE hier oder im Chat: secret key (sb_secret_…), service_role key, Datenbank-Passwort, Zugangstoken.
# Die gehören in GitHub → Settings → Secrets and variables → Actions (siehe docs/02-architektur.md).

# Supabase-Projekt in Zürich (eu-central-2): im Projekt oben »Connect« → Project URL
# (Form https://<ref>.supabase.co; <ref> steht auch in der Dashboard-Adresse …/project/<ref>)
PUBLIC_SUPABASE_URL=
# »Connect« oder Settings → API Keys → Publishable key (beginnt mit sb_publishable_)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
