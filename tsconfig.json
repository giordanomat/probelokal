{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// worker-configuration.d.ts importiert den gebauten Worker (.svelte-kit/cloudflare/_worker.js);
		// ohne das würde svelte-check nach einem Build die erzeugten JS-Dateien prüfen.
		"checkJs": false,
		"types": ["$app/types", "node", "./worker-configuration.d.ts"]
	},
	"exclude": ["src/service-worker"],
	"include": ["src", "vite.config.ts", "playwright.config.ts", "e2e", "supabase/tests"]
}
